        { "kind": "idle", "minutes": 20 },
        { "kind": "emit", "text": "Looking up order 4921" }
      ],
      "result": {
        "status": "running",
        "buffer": [
          { "id": 1, "text": "Reading ticket #8823" },
          { "id": 2, "text": "Looking up order 4921" }
        ],
        "deliveries": [{ "client": "tab-1", "events": [1] }]
      }
    },
    {
      "id": "coming-back-resets-the-abandon-clock",
      "timeline": [
        { "kind": "emit", "text": "Reading ticket #8823" },
        { "kind": "connect", "client": "tab-1", "lastEventId": null },
        { "kind": "disconnect", "client": "tab-1" },
