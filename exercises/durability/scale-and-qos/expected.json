        { "id": "ticket-2", "priority": 3, "tenant": "standard-b" },
        { "id": "chat-2", "priority": 1, "tenant": "standard-b" }
      ],
      "result": ["chat-1", "chat-2", "ticket-1", "ticket-2"]
    },
