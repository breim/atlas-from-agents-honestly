      "calls": [
        { "tool": "send_reply", "scope": 0, "templated": true, "count": 1 },
        { "tool": "send_reply", "scope": 0, "templated": false, "count": 1 }
      ],
      "result": {
        "decisions": [
          { "tool": "send_reply", "posture": "notify" },
          { "tool": "send_reply", "posture": "approve" }
        ],
        "approvals": 1,
        "affordable": true
      }
    },
    {
      "id": "publishing-widely-costs-more-than-reading",
      "calls": [
        { "tool": "publish_report", "scope": 1, "templated": false, "count": 1 },
        { "tool": "publish_report", "scope": 50, "templated": false, "count": 1 },
        { "tool": "publish_report", "scope": 5000, "templated": false, "count": 1 }
      ],
      "result": {
        "decisions": [
          { "tool": "publish_report", "posture": "auto" },
