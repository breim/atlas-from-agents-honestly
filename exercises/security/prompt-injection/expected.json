        "call": { "tool": "get_order", "orderId": "4921", "amountCents": 0, "recipient": null }
      },
      "result": {
        "tainted": false,
        "sources": [],
        "trifecta": { "privateData": false, "untrustedContent": false, "exfiltration": false },
        "lethal": false,
