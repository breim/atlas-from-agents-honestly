      "id": "a-delegation-names-both-principals-and-is-allowed",
      "token": {
        "model": "delegation",
        "sub": "user:jvega",
        "act": "agent:atlas",
        "scopes": [
          "orders:read"
        ],
        "expiresAtMs": 100000
      },
      "action": {
        "backend": "orders",
        "atMs": 1000,
        "runId": "run-8823",
        "delegationRef": "del-9f2c",
        "storedToken": null,
        "ownerHuman": null,
        "scheduled": false
      },
      "backends": [
        {
          "name": "orders",
          "requiredScopes": [
            "orders:read"
          ],
          "filtersOnRead": false
        },
        {
          "name": "hr",
          "requiredScopes": [
            "hr:read"
          ],
          "filtersOnRead": true
        }
