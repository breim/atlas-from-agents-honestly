          { "name": "triage", "input": "ticket-9104", "declaresDone": true, "next": null }
        ]
      },
      "budget": { "maxSteps": 10 },
      "result": {
        "steps": [{ "agent": "triage", "compressionDepth": 1 }],
        "outcome": "completed",
        "terminatedBy": "triage",
        "violations": []
      }
    }
  ]
}
