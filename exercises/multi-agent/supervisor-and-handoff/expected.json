    {
      "id": "a-chain-that-ends-with-nobody-drops-the-ticket",
      "plan": {
        "topology": "handoff",
        "start": "triage",
        "verifiesAgainst": "sources",
        "agents": [
          { "name": "triage", "input": "ticket-9104", "declaresDone": false, "next": "billing" },
          { "name": "billing", "input": "ticket-9104", "declaresDone": false, "next": null }
        ]
      },
