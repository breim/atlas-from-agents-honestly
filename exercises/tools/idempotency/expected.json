          "id": "a1",
          "runId": "run-8823",
          "tool": "issue_credit",
          "args": {
            "accountId": "4471",
            "amountCents": 420000
          },
          "transport": "timeout"
        },
        {
          "id": "a2",
          "runId": "run-8823",
          "tool": "issue_credit",
          "args": {
            "accountId": "4471",
            "amountCents": 420000
          },
          "transport": "ok"
