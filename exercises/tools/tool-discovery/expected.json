  ],
  "cases": [
    {
      "id": "a-query-that-matches-nothing-loads-nothing",
      "query": "thank you for your help",
      "limit": 3,
      "result": {
        "ok": true,
        "resident": ["tool_search", "escalate_to_human"],
        "appended": [],
        "prefixTokens": 400,
        "totalTokens": 400
      }
    },
    {
      "id": "matching-tools-are-loaded-strongest-first",
      "query": "overdue invoice for account",
      "limit": 3,
      "result": {
        "ok": true,
        "resident": ["tool_search", "escalate_to_human"],
        "appended": ["erp_list_unpaid_invoices", "crm_lookup_account", "erp_issue_credit"],
        "prefixTokens": 400,
        "totalTokens": 1260
      }
    },
    {
      "id": "the-limit-drops-the-weakest-match-not-the-last-one",
      "query": "invoice credit refund for the account",
      "limit": 2,
      "result": {
        "ok": true,
        "resident": ["tool_search", "escalate_to_human"],
        "appended": ["erp_issue_credit", "crm_lookup_account"],
        "prefixTokens": 400,
        "totalTokens": 950
      }
    },
    {
      "id": "a-generous-limit-is-not-padded-with-non-matches",
      "query": "check part stock in the warehouse",
      "limit": 5,
      "result": {
        "ok": true,
        "resident": ["tool_search", "escalate_to_human"],
        "appended": ["wms_check_stock"],
        "prefixTokens": 400,
        "totalTokens": 640
      }
    },
    {
      "id": "a-namespace-prefix-alone-finds-the-server",
      "query": "slack",
      "limit": 3,
      "result": {
        "ok": true,
        "resident": ["tool_search", "escalate_to_human"],
        "appended": ["slack_post_message"],
        "prefixTokens": 400,
        "totalTokens": 630
      }
    },
    {
      "id": "a-resident-tool-is-never-loaded-a-second-time",
      "query": "escalate to a human supervisor",
      "limit": 3,
      "result": {
        "ok": true,
        "resident": ["tool_search", "escalate_to_human"],
        "appended": [],
        "prefixTokens": 400,
        "totalTokens": 400
      }
    },
    {
      "id": "a-catalogue-that-defers-everything-is-rejected",
      "catalogue": "deferredOnly",
      "query": "overdue invoice for account",
      "limit": 3,
      "result": { "ok": false, "error": "no_resident_search" }
    },
    {
      "id": "a-search-tool-with-nothing-visible-is-rejected",
      "catalogue": "searchOnly",
      "query": "overdue invoice for account",
      "limit": 3,
      "result": { "ok": false, "error": "no_resident_action" }
    }
  ]
}
