{
  "chapter": "tools/tool-discovery",
  "tier": "drill",
  "notes": [
    "A large catalogue is declared but not loaded. A small resident set sits at position",
    "zero and never changes; a search over names and keywords appends the few schemas a",
    "request actually needs, after the cached prefix rather than in place of it.",
    "Tools are ranked by how many distinct query words their keywords cover, ties broken",
    "by catalogue order, and only tools that match at all are loaded.",
    "A catalogue that defers everything is rejected. An agent whose every capability is",
    "invisible cannot know that searching is worth doing."
  ],
  "catalogue": [
    {
      "name": "tool_search",
      "kind": "search",
      "tokens": 180,
      "resident": true,
      "keywords": ["search", "tool", "find", "capability"]
    },
    {
      "name": "escalate_to_human",
      "kind": "action",
      "tokens": 220,
      "resident": true,
      "keywords": ["escalate", "human", "supervisor", "handoff"]
    },
    {
      "name": "crm_lookup_account",
      "kind": "action",
      "tokens": 260,
      "resident": false,
      "keywords": ["crm", "account", "customer", "lookup"]
    },
    {
      "name": "erp_list_unpaid_invoices",
      "kind": "action",
      "tokens": 310,
      "resident": false,
      "keywords": ["erp", "invoice", "unpaid", "overdue", "balance"]
    },
    {
      "name": "erp_issue_credit",
      "kind": "action",
      "tokens": 290,
      "resident": false,
      "keywords": ["erp", "credit", "refund", "invoice"]
    },
    {
      "name": "wms_check_stock",
      "kind": "action",
      "tokens": 240,
      "resident": false,
      "keywords": ["wms", "stock", "inventory", "warehouse", "part"]
    },
    {
      "name": "carrier_track_shipment",
      "kind": "action",
      "tokens": 270,
      "resident": false,
      "keywords": ["carrier", "shipment", "tracking", "delivery"]
    },
    {
      "name": "jira_create_issue",
      "kind": "action",
      "tokens": 250,
      "resident": false,
      "keywords": ["jira", "issue", "ticket", "engineering"]
    },
    {
      "name": "slack_post_message",
      "kind": "action",
      "tokens": 230,
      "resident": false,
      "keywords": ["slack", "message", "notify", "channel"]
    }
  ],
  "deferredOnly": [
    {
      "name": "tool_search",
      "kind": "search",
      "tokens": 180,
      "resident": false,
      "keywords": ["search", "tool", "find", "capability"]
    },
    {
      "name": "escalate_to_human",
      "kind": "action",
      "tokens": 220,
      "resident": false,
      "keywords": ["escalate", "human", "supervisor", "handoff"]
    },
    {
      "name": "crm_lookup_account",
      "kind": "action",
      "tokens": 260,
      "resident": false,
      "keywords": ["crm", "account", "customer", "lookup"]
    }
  ],
  "searchOnly": [
    {
      "name": "tool_search",
      "kind": "search",
      "tokens": 180,
      "resident": true,
      "keywords": ["search", "tool", "find", "capability"]
    },
    {
      "name": "escalate_to_human",
      "kind": "action",
      "tokens": 220,
      "resident": false,
      "keywords": ["escalate", "human", "supervisor", "handoff"]
    },
    {
      "name": "crm_lookup_account",
      "kind": "action",
      "tokens": 260,
      "resident": false,
      "keywords": ["crm", "account", "customer", "lookup"]
