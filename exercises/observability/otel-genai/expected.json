{
  "chapter": "observability/otel-genai",
  "tier": "drill",
  "notes": [
    "Four layers instrument the same run, so exactly one owner is declared per span type.",
    "A span emitted by anyone else is dropped: it is duplicate instrumentation, and the",
    "trace it produces looks more complete rather than broken.",
    "Summed tokens over the kept spans are compared against the provider's reported usage.",
    "That ten-minute check is what finds the double count.",
    "Attribute keys are checked on kept spans only: a gen_ai.* key the conventions do not",
    "define is an overload, and a key in nobody's namespace belongs to nobody.",
    "Content capture is off by default. The payloads leave the span; the hash that replaces",
    "them lives in the object store, which is not this function's problem."
  ],
  "config": {
    "owners": {
      "invoke_agent": "workflow",
      "chat": "sdk",
      "execute_tool": "dispatcher"
    },
    "conventionKeys": [
      "gen_ai.request.model",
      "gen_ai.response.finish_reasons",
      "gen_ai.usage.input_tokens",
      "gen_ai.usage.output_tokens",
      "gen_ai.input.messages",
      "gen_ai.output.messages",
      "gen_ai.system_instructions"
    ],
    "contentKeys": [
      "gen_ai.input.messages",
      "gen_ai.output.messages",
      "gen_ai.system_instructions"
    ],
    "namespace": "meridian",
    "captureContent": false
  },
  "cases": [
    {
      "id": "a-clean-trace-keeps-every-span",
      "providerTokens": 1500,
      "spans": [
        { "id": "w1", "type": "invoke_agent", "emitter": "workflow", "attributes": { "meridian.route": "policy" } },
        {
          "id": "c1",
          "type": "chat",
          "emitter": "sdk",
          "attributes": {
            "gen_ai.request.model": "atlas-1",
            "gen_ai.usage.input_tokens": 1200,
            "gen_ai.usage.output_tokens": 300
          }
        },
        { "id": "t1", "type": "execute_tool", "emitter": "dispatcher", "attributes": { "meridian.tool.truncated": false } }
      ],
      "result": {
        "kept": ["w1", "c1", "t1"],
        "dropped": [],
        "redacted": [],
        "violations": [],
        "tokens": 1500,
        "tokensMatchProvider": true
      }
    },
    {
