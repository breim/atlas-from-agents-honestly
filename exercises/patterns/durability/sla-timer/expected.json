{
  "chapter": "patterns/durability/sla-timer",
  "tier": "micro",
  "notes": [
    "Events arrive in time order. An `extend` moves the deadline; a `resolve` cancels the",
    "timer. The timer fires at the deadline standing at that moment — not the original one.",
    "Times are plain integers so the boundary is testable."
  ],
  "cases": [
    {
      "id": "an-unresolved-timer-fires-at-its-deadline",
      "deadline": 100,
      "events": [],
      "horizon": 200,
      "result": { "fired": true, "at": 100 }
    },
    {
      "id": "resolving-before-the-deadline-cancels-the-timer",
      "deadline": 100,
      "events": [{ "kind": "resolve", "at": 50 }],
      "horizon": 200,
      "result": { "fired": false, "at": null }
    },
    {
      "id": "extending-moves-the-deadline",
      "deadline": 100,
      "events": [{ "kind": "extend", "at": 50, "to": 300 }],
      "horizon": 400,
      "result": { "fired": true, "at": 300 }
    },
    {
      "id": "an-extension-after-the-timer-fired-is-ignored",
      "deadline": 100,
      "events": [{ "kind": "extend", "at": 150, "to": 500 }],
      "horizon": 600,
      "result": { "fired": true, "at": 100 }
    },
    {
      "id": "resolving-after-the-timer-fired-does-not-unfire-it",
      "deadline": 100,
      "events": [{ "kind": "resolve", "at": 150 }],
      "horizon": 200,
      "result": { "fired": true, "at": 100 }
    },
    {
      "id": "the-last-extension-before-the-deadline-wins",
      "deadline": 100,
      "events": [
        { "kind": "extend", "at": 20, "to": 200 },
        { "kind": "extend", "at": 150, "to": 400 }
      ],
      "horizon": 500,
      "result": { "fired": true, "at": 400 }
    },
    {
      "id": "an-extension-can-shorten-the-deadline",
      "deadline": 300,
      "events": [{ "kind": "extend", "at": 10, "to": 50 }],
      "horizon": 400,
      "result": { "fired": true, "at": 50 }
    },
    {
      "id": "a-deadline-beyond-the-horizon-has-not-fired-yet",
      "deadline": 900,
      "events": [],
      "horizon": 200,
      "result": { "fired": false, "at": null }
    }
  ]
}
