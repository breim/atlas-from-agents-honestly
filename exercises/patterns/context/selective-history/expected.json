{
  "chapter": "patterns/context/selective-history",
  "tier": "micro",
  "notes": [
    "The tail is unconditional. A relevance score is a guess, and dropping the turn the",
    "user just wrote because a scorer disagreed is the failure this pattern exists to avoid."
  ],
  "cases": [
    {
      "id": "everything-scores-above-the-threshold",
      "threshold": 0.5,
      "keepLast": 2,
      "history": [
        { "id": "t1", "score": 0.9 },
        { "id": "t2", "score": 0.7 },
        { "id": "t3", "score": 0.6 }
      ],
      "kept": ["t1", "t2", "t3"]
    },
    {
      "id": "drops-what-scores-below",
      "threshold": 0.5,
      "keepLast": 1,
      "history": [
        { "id": "t1", "score": 0.9 },
        { "id": "t2", "score": 0.2 },
        { "id": "t3", "score": 0.8 }
      ],
      "kept": ["t1", "t3"]
    },
    {
      "id": "the-tail-is-kept-regardless-of-score",
      "threshold": 0.5,
      "keepLast": 2,
      "history": [
        { "id": "t1", "score": 0.9 },
        { "id": "t2", "score": 0.1 },
        { "id": "t3", "score": 0.1 }
      ],
      "kept": ["t1", "t2", "t3"]
    },
    {
      "id": "the-threshold-is-inclusive",
      "threshold": 0.5,
      "keepLast": 0,
      "history": [
        { "id": "t1", "score": 0.5 },
        { "id": "t2", "score": 0.49 }
      ],
      "kept": ["t1"]
    },
    {
      "id": "kept-entries-hold-their-original-order",
      "threshold": 0.5,
      "keepLast": 1,
      "history": [
        { "id": "t1", "score": 0.1 },
        { "id": "t2", "score": 0.9 },
        { "id": "t3", "score": 0.1 },
        { "id": "t4", "score": 0.9 }
      ],
      "kept": ["t2", "t4"]
    },
    {
      "id": "a-tail-longer-than-the-history-keeps-everything",
      "threshold": 0.9,
      "keepLast": 10,
      "history": [
        { "id": "t1", "score": 0.1 },
        { "id": "t2", "score": 0.1 }
      ],
      "kept": ["t1", "t2"]
    }
  ]
}
