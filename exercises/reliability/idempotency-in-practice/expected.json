        "key": "run-8823:issue_credit",
        "atMs": 1000,
        "worker": "w1",
        "outcome": "ok",
        "effect": "credit-88",
        "slowestCallMs": 30000,
        "runAliveUntilMs": 999999999,
        "external": false
      },
      "store": {
        "rows": {},
        "windowMs": 604800000,
        "durable": true,
        "transactional": true
      },
      "config": {
        "leaseMs": 60000,
        "approvalPauseMs": 259200000
      },
      "result": {
        "status": "applied",
        "errors": [],
        "alerts": [],
        "effects": 1,
        "store": {
          "rows": {
            "run-8823:issue_credit": {
              "key": "run-8823:issue_credit",
              "state": "DONE",
              "leaseUntilMs": 61000,
              "result": "credit-88"
            }
          },
          "windowMs": 604800000,
          "durable": true,
          "transactional": true
        },
        "outbox": []
      }
    },
