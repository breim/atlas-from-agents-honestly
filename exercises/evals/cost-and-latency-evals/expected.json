{
  "chapter": "evals/cost-and-latency-evals",
  "tier": "drill",
  "notes": [
    "Cost per accepted outcome: every cent spent on top, only resolved runs on the bottom.",
    "A run that escalated is paid for and bought nothing. Cost per attempt is computed too,",
    "and reported rather than gated, because it is the number that flatters a release.",
    "Latency excludes human wait. A three-day approval is the system working, and counting",
    "it would make the correct behaviour score worst.",
    "p95 is nearest-rank on the ascending sort: index ceil(95n/100) - 1. Rates are basis",
    "points rounded with floor(x + 0.5).",
    "Three gates, and a release passes only if all three do. Quality alone rewards spending",
    "more; cost alone rewards answering quickly and badly.",
    "With nothing measured, the latency gate passes vacuously — nothing exceeded a budget."
  ],
  "budgets": {
    "ttftP95Ms": 1000,
    "totalP95Ms": 30000,
    "hardCeilingMs": 60000,
    "overCeilingBps": 100
  },
  "baseline": { "resolvedRateBps": 8000, "costPerOutcomeCents": 100 },
  "noiseBandBps": 2000,
  "cases": [
    {
      "id": "a-healthy-release-passes-all-three-gates",
      "runs": [
        { "outcome": "resolved", "costCents": 10, "ttftMs": 400, "totalMs": 5000, "humanWaitMs": 0 },
        { "outcome": "resolved", "costCents": 10, "ttftMs": 400, "totalMs": 5000, "humanWaitMs": 0 },
        { "outcome": "resolved", "costCents": 10, "ttftMs": 400, "totalMs": 5000, "humanWaitMs": 0 },
        { "outcome": "resolved", "costCents": 10, "ttftMs": 400, "totalMs": 5000, "humanWaitMs": 0 },
        { "outcome": "escalated", "costCents": 10, "ttftMs": 400, "totalMs": 5000, "humanWaitMs": 0 }
      ],
      "result": {
        "resolvedRateBps": 8000,
        "costPerOutcomeCents": 13,
        "costPerAttemptCents": 10,
        "ttftP95Ms": 400,
        "totalP95Ms": 5000,
        "overCeilingBps": 0,
        "gates": { "quality": true, "cost": true, "latency": true, "pass": true }
      }
    },
    {
      "id": "a-run-that-escalated-is-paid-for-and-bought-nothing",
      "runs": [
        { "outcome": "resolved", "costCents": 20, "ttftMs": 400, "totalMs": 5000, "humanWaitMs": 0 },
        { "outcome": "escalated", "costCents": 20, "ttftMs": 400, "totalMs": 5000, "humanWaitMs": 0 },
        { "outcome": "escalated", "costCents": 20, "ttftMs": 400, "totalMs": 5000, "humanWaitMs": 0 },
        { "outcome": "escalated", "costCents": 20, "ttftMs": 400, "totalMs": 5000, "humanWaitMs": 0 },
        { "outcome": "abandoned", "costCents": 20, "ttftMs": 400, "totalMs": 5000, "humanWaitMs": 0 }
      ],
      "result": {
        "resolvedRateBps": 2000,
        "costPerOutcomeCents": 100,
        "costPerAttemptCents": 20,
        "ttftP95Ms": 400,
        "totalP95Ms": 5000,
        "overCeilingBps": 0,
        "gates": { "quality": false, "cost": true, "latency": true, "pass": false }
