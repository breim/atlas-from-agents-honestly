        "state": {},
        "views": []
      }
    },
    {
      "id": "a-router-that-reads-the-transcript-is-rejected",
      "graph": "transcriptRouter",
      "input": {},
      "updates": {},
      "subUpdates": {},
      "result": {
        "status": "invalid",
        "errors": ["router at agent reads messages, which is transcript state"],
        "path": [],
        "superSteps": 0,
        "state": {},
        "views": []
      }
    },
    {
      "id": "a-backstop-below-the-semantic-bound-inverts-the-arrangement",
      "graph": "lowBackstop",
      "input": {},
      "updates": {},
      "subUpdates": {},
      "result": {
        "status": "invalid",
        "errors": ["the backstop at 25 fires before the semantic bound at 36 super-steps"],
