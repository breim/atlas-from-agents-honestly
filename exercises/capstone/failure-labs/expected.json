        {
          "name": "duplicate-signal",
          "fault": "tool timeout",
          "window": "between call and record",
          "invariant": "one credit per order",
          "evidence": [
            "ledger",
            "trace"
          ],
          "inspects": "effect-state",
          "assertsBefore": [
            "rerank",
            "prompt-assembly",
            "graph-hop"
          ],
          "bypass": "attempted",
          "boundHasTerminalPolicy": true,
          "promotedTo": "unit",
          "artifactsPreserved": true
        }
      ],
      "policy": {
        "required": [
          "fault",
          "window",
          "invariant"
        ],
        "isolationCheckpoints": [
          "rerank",
          "prompt-assembly",
          "graph-hop"
